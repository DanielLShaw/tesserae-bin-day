# Auto detect text files and perform LF normalization
* text=auto

# Keep the release tarball to plugin folders only (the installer rejects
# any root directory without a plugin.json). Anchored at the root, so each
# plugin's own tests/ still ships.
/tests/ export-ignore
/preview/ export-ignore
/.github/ export-ignore
/docs/ export-ignore
/conftest.py export-ignore
