{
  "tesserae_compat": "1.x",
  "name": "Bin Day",
  "version": "0.2.0",
  "kind": "widget",
  "description": "Which bins are collected in the next 7 days and how many days until each collection, from a Home Assistant calendar (such as Waste Collection Schedule's) or a schedule you enter. Set your bins up in Bin Day Core.",
  "icon": "ph-trash",
  "supports": {
    "sizes": [
      "xs",
      "sm",
      "md",
      "lg"
    ]
  },
  "requires": [
    "plugin:bin_day_core"
  ],
  "cell_options": [
    {
      "name": "show_title",
      "type": "boolean",
      "label": "Show title row",
      "default": true,
      "help": "Off hides the title bar: its icon and text."
    },
    {
      "name": "title",
      "type": "string",
      "label": "Title",
      "default": "",
      "help": "The title bar's text. Leave empty for Bins.",
      "show_if": {
        "show_title": true
      }
    },
    {
      "name": "cutoff",
      "type": "select",
      "label": "Collection done by",
      "default": "10:00",
      "choices": [
        {
          "value": "06:00",
          "label": "06:00"
        },
        {
          "value": "06:30",
          "label": "06:30"
        },
        {
          "value": "07:00",
          "label": "07:00"
        },
        {
          "value": "07:30",
          "label": "07:30"
        },
        {
          "value": "08:00",
          "label": "08:00"
        },
        {
          "value": "08:30",
          "label": "08:30"
        },
        {
          "value": "09:00",
          "label": "09:00"
        },
        {
          "value": "09:30",
          "label": "09:30"
        },
        {
          "value": "10:00",
          "label": "10:00"
        },
        {
          "value": "10:30",
          "label": "10:30"
        },
        {
          "value": "11:00",
          "label": "11:00"
        },
        {
          "value": "11:30",
          "label": "11:30"
        },
        {
          "value": "12:00",
          "label": "12:00"
        },
        {
          "value": "12:30",
          "label": "12:30"
        },
        {
          "value": "13:00",
          "label": "13:00"
        },
        {
          "value": "13:30",
          "label": "13:30"
        },
        {
          "value": "14:00",
          "label": "14:00"
        },
        {
          "value": "14:30",
          "label": "14:30"
        },
        {
          "value": "15:00",
          "label": "15:00"
        },
        {
          "value": "15:30",
          "label": "15:30"
        },
        {
          "value": "16:00",
          "label": "16:00"
        },
        {
          "value": "16:30",
          "label": "16:30"
        },
        {
          "value": "17:00",
          "label": "17:00"
        },
        {
          "value": "17:30",
          "label": "17:30"
        },
        {
          "value": "18:00",
          "label": "18:00"
        },
        {
          "value": "18:30",
          "label": "18:30"
        },
        {
          "value": "19:00",
          "label": "19:00"
        },
        {
          "value": "19:30",
          "label": "19:30"
        },
        {
          "value": "20:00",
          "label": "20:00"
        }
      ],
      "help": "After this time on collection day, today's bins count as collected and the next collection is shown."
    },
    {
      "name": "colours",
      "type": "select",
      "label": "Colours",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "Auto (follow the theme)"
        },
        {
          "value": "colour",
          "label": "Colour"
        },
        {
          "value": "eink",
          "label": "Colour for e-ink"
        },
        {
          "value": "mono",
          "label": "Black & white"
        }
      ],
      "help": "Colour suits screens. Colour for e-ink uses the exact inks of colour e-ink panels such as the reTerminal E1002, so bins print as solid ink. Black & white draws each bin solid, outlined or patterned, for mono panels. Auto uses Colour, or Black & white on black and white themes such as Paper and Newsprint."
    },
    {
      "name": "small_cells",
      "type": "select",
      "label": "Small cells show",
      "default": "chips",
      "choices": [
        {
          "value": "chips",
          "label": "Chips"
        },
        {
          "value": "bins",
          "label": "Wheelie bins"
        }
      ],
      "help": "For XS and SM cells. Chips show the next two collection days, each bin as a coloured square. Wheelie bins show only the next collection, its bins drawn as large as the cell allows. MD and LG cells always show wheelie bins."
    },
    {
      "name": "show_names",
      "type": "boolean",
      "label": "Show bin names",
      "default": true,
      "help": "Off hides the names above wheelie bins, and in LG's list of later days. The bins grow into the space."
    }
  ],
  "fragments": [
    {
      "id": "full",
      "label": "Bins",
      "w": 380,
      "h": 240,
      "icon": "ph-trash"
    },
    {
      "id": "next",
      "label": "Next collection",
      "w": 240,
      "h": 200,
      "icon": "ph-calendar-check"
    },
    {
      "id": "bins",
      "label": "Bins only",
      "w": 200,
      "h": 160,
      "icon": "ph-trash"
    },
    {
      "id": "countdown",
      "label": "Countdown",
      "w": 200,
      "h": 100,
      "icon": "ph-clock-countdown"
    },
    {
      "id": "chips",
      "label": "Next two days",
      "w": 380,
      "h": 120,
      "icon": "ph-squares-four"
    }
  ],
  "updates": {
    "on_schedule": [
      {
        "kind": "daily",
        "suggested_at": "00:05"
      }
    ]
  },
  "data_schema": {
    "fields": [
      {
        "name": "next_days_until",
        "type": "num",
        "label": "Days until the next collection",
        "unit": "days"
      },
      {
        "name": "next_bins",
        "type": "str",
        "label": "Bins in the next collection"
      },
      {
        "name": "next_date",
        "type": "str",
        "label": "Date of the next collection"
      },
      {
        "name": "days",
        "type": "arr",
        "label": "Collection days"
      }
    ],
    "sample": {
      "days": [
        {
          "date": "2026-10-07",
          "days_until": 1,
          "streams": [
            {
              "id": "refuse",
              "label": "Refuse",
              "icon": "trash",
              "body_colour": "#6b2c91",
              "lid_colour": "#6b2c91",
              "icon_colour": "#ffffff",
              "chip_icon_colour": "#ffffff",
              "mono_fill": "solid"
            },
            {
              "id": "garden",
              "label": "Green",
              "icon": "leaf",
              "body_colour": "#13803a",
              "lid_colour": "#13803a",
              "icon_colour": "#ffffff",
              "chip_icon_colour": "#ffffff",
              "mono_fill": "hatched"
            }
          ]
        },
        {
          "date": "2026-10-12",
          "days_until": 6,
          "streams": [
            {
              "id": "recycling",
              "label": "Recycling",
              "icon": "recycle",
              "body_colour": "#1f4fd1",
              "lid_colour": "#1f4fd1",
              "icon_colour": "#ffffff",
              "chip_icon_colour": "#ffffff",
              "mono_fill": "white"
            }
          ]
        }
      ],
      "next_days_until": 1,
      "next_date": "2026-10-07",
      "next_bins": "Refuse, Green",
      "next_change_at": "2026-10-07T00:00:00+01:00"
    }
  },
  "design": {
    "palette": "extended"
  },
  "locales": [
    "en"
  ]
}
